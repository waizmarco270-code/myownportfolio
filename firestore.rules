rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Fields:
    //   - title: string (required)
    //   - description: string (required)
    //   - link: string (required)
    //   - logoBase64: string (required)
    //   - tech: list (optional)
    //   - features: list (optional)
    //   - order: number (optional)
    //
    // Collection: users
    // Fields:
    //   - email: string (required)
    //   - role: string (required, enum: ['admin', 'user'])
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "waizmonazzum270@gmail.com";
    }

    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 &&
             data.description is string && data.description.size() > 0 &&
             data.link is string &&
             data.logoBase64 is string;
    }

    // Projects Rules
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Users Rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Settings Rules
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Messages Rules
    match /messages/{messageId} {
      allow read, write: if true;
    }
  }
}
