{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A showcase project in the portfolio.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Project title" },
        "description": { "type": "string", "description": "Project description" },
        "link": { "type": "string", "description": "Live URL of the project" },
        "logoBase64": { "type": "string", "description": "Base64 encoded logo image" },
        "tech": { "type": "array", "items": { "type": "string" }, "description": "Technologies used" },
        "features": { "type": "array", "items": { "type": "string" }, "description": "Key features" },
        "order": { "type": "number", "description": "Display order" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "link", "logoBase64"]
    },
    "User": {
      "title": "User",
      "description": "Application user profile.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["email", "role"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global configuration for the portfolio.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "github": { "type": "string" },
        "linkedin": { "type": "string" },
        "twitter": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "role", "bio"]
    },
    "Message": {
      "title": "Message",
      "description": "A contact message from a visitor.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of portfolio projects."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/settings/global": {
      "schema": "SiteSettings",
      "description": "Global site configuration."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Visitor contact messages."
    }
  }
}
